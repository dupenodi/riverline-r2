# Daily
DAILY_API_KEY=
DAILY_API_URL=https://api.daily.co/v1

# Agent
AGENT_HOST=0.0.0.0
AGENT_PORT=7860

# Web (browser reaches agent via host-mapped port)
NEXT_PUBLIC_AGENT_URL=http://localhost:7860
# Used for absolute Open Graph / Twitter URLs
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Voice pipeline (required)
SARVAM_API_KEY=
# Only needed when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Optional overrides
# Turn-loop LLM: sarvam (default) or openrouter.
# LLM_PROVIDER=sarvam
# SARVAM_LLM_MODEL=sarvam-105b-conversations
# OPENROUTER_MODEL=openai/gpt-4.1-nano
# SARVAM_LANGUAGE=en-IN
# SARVAM_VOICE=shubh
# SARVAM_TTS_MODEL=bulbul:v3
