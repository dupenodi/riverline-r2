# Copy to .env at the repo root. docker compose loads this file.
# Get keys: https://dashboard.daily.co/  https://dashboard.sarvam.ai/

# --- required ---
DAILY_API_KEY=
SARVAM_API_KEY=

# --- Daily ---
DAILY_API_URL=https://api.daily.co/v1
# DAILY_ROOM_TTL_SECS=3600

# --- agent bind (compose also sets these) ---
AGENT_HOST=0.0.0.0
AGENT_PORT=7860

# --- web: browser → agent. Passed as a build arg in compose. ---
NEXT_PUBLIC_AGENT_URL=http://localhost:7860
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SQLite. Compose uses /data/kubera.db on a named volume. ---
# KUBERA_DB_PATH=

# --- Sarvam (optional). Voice LLM, summary, and advice rewrite must be /v1.
# gemma4 / glm5.2 need /v2 and will fail tools + summarization.
# SARVAM_LLM_MODEL=sarvam-105b-conversations
# SARVAM_SUMMARY_MODEL=sarvam-105b-conversations
# SARVAM_LANGUAGE=en-IN
# SARVAM_VOICE=rohan
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_TEMPERATURE=0.8

# --- call timing (optional) ---
# PIPELINE_IDLE_SECS=120
# BOT_JOIN_TIMEOUT_SECS=15
# VAD_CONFIDENCE=0.7
# VAD_START_SECS=0.1
# VAD_STOP_SECS=1.5
